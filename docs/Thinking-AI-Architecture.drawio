        <mxCell id="c26" value="Write text index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718a;fontSize=12;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c20" target="c22">
