<mxfile host="app.diagrams.net" modified="2026-10-21T05:30:00.000Z" agent="Thinking AI architecture" version="24.7.17" type="device"><diagram id="page-1" name="01 · Live architecture"><mxGraphModel dx="1820" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;THINKING AI  /  01  /  Live architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#29344A;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1700" height="50" /></mxCell><mxCell id="subtitle" value="Public HTTPS frontend + serverless API + browser-held documents. Active AI provider: Google Gemini 3.5 Flash-Lite." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="82" width="1700" height="48" /></mxCell><mxCell id="aws" value="AWS ACCOUNT 912010732788  |  Regional services: us-east-1  |  CloudFront: global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#52637A;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="150" width="970" height="1030" /></mxCell><mxCell id="browser" value="&lt;b&gt;User browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTML / JavaScript UI&lt;br&gt;Free chat or Pro account&lt;br&gt;PDF.js / Mammoth / text extraction&lt;br&gt;Document and chat held in tab memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=17;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="475" width="310" height="255" /></mxCell><mxCell id="cloudfront" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;&lt;br&gt;Global HTTPS distribution + cache&lt;br&gt;d3nv2zhw5ihk84.cloudfront.net&lt;br&gt;Default root object: index.html&lt;br&gt;Distribution: E1Q60LVMJ9T8M9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#8065AF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="220" width="330" height="165" /></mxCell><mxCell id="s3" value="&lt;b&gt;Amazon S3 · private origin&lt;/b&gt;&lt;br&gt;&lt;br&gt;Website assets only: HTML + JS&lt;br&gt;thinking-ai-web-912010732788&lt;br&gt;Block Public Access enabled&lt;br&gt;OAC + distribution-scoped bucket policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3ED;strokeColor=#52977D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="220" width="340" height="165" /></mxCell><mxCell id="cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;br&gt;Name + email + password&lt;br&gt;Email code verification&lt;br&gt;Sign-in issues JWT&lt;br&gt;Tokens stay in browser memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE9EE;strokeColor=#B8758D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="485" width="265" height="185" /></mxCell><mxCell id="api" value="&lt;b&gt;API Gateway · HTTP API&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /free: anonymous&lt;br&gt;POST /chat: JWT authorizer&lt;br&gt;Explicit CORS origins&lt;br&gt;Rate 1/s · burst 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#8065AF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="485" width="250" height="185" /></mxCell><mxCell id="lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;br&gt;Python 3.12 · ARM64&lt;br&gt;256 MB · 28 s timeout&lt;br&gt;Validate + admit usage&lt;br&gt;Retrieve passages + invoke model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#D49136;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="485" width="250" height="185" /></mxCell><mxCell id="gemini" value="&lt;b&gt;Google Gemini · ACTIVE&lt;/b&gt;&lt;br&gt;&lt;br&gt;gemini-3.5-flash-lite&lt;br&gt;HTTPS generateContent request&lt;br&gt;Question + selected document passages&lt;br&gt;Maximum 1,024 output tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="485" width="325" height="185" /></mxCell><mxCell id="usage" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Atomic daily usage counters&lt;br&gt;Free network / shared Free / global&lt;br&gt;Pro account + global&lt;br&gt;On-demand billing · TTL cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="800" width="260" height="175" /></mxCell><mxCell id="ssm" value="&lt;b&gt;SSM Parameter Store&lt;/b&gt;&lt;br&gt;&lt;br&gt;SecureString API key&lt;br&gt;/ thinking-ai / gemini-api-key&lt;br&gt;Decrypt via AWS managed key&lt;br&gt;Key cached in Lambda memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3ED;strokeColor=#52977D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="800" width="250" height="175" /></mxCell><mxCell id="logs" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lambda errors + request metadata&lt;br&gt;Log retention: 3 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE9EE;strokeColor=#B8758D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1080" y="1020" width="250" height="125" /></mxCell><mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock · PLANNED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Amazon Nova Micro&lt;br&gt;Access / quota review requested&lt;br&gt;PRIMARY_PROVIDER is gemini&lt;br&gt;Not called by the active configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#98A3B5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="805" width="325" height="170" /></mxCell><mxCell id="delivery" value="1 · GET website over HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="cloudfront"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="195" y="300" /></Array></mxGeometry></mxCell><mxCell id="origin" value="2 · Signed origin request through OAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cloudfront" target="s3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="login" value="Pro sign-up / verify / sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.22;entryX=0;entryY=0.3;" edge="1" parent="1" source="browser" target="cognito"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="post" value="3 · Question + optional document text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.85;entryX=0.5;entryY=1;" edge="1" parent="1" source="browser" target="api"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="380" y="740" /><mxPoint x="905" y="740" /></Array></mxGeometry></mxCell><mxCell id="jwt" value="Validate Pro JWT using issuer keys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;dashed=1;exitX=0;exitY=0.6;entryX=1;entryY=0.6;" edge="1" parent="1" source="api" target="cognito"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="invoke" value="4 · Invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="api" target="lambda"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="llm" value="6 · Invoke Gemini" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="lambda" target="gemini"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="reserve" value="5 · Reserve quota before AI call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=0.25;exitY=1;entryX=1;entryY=0.4;" edge="1" parent="1" source="lambda" target="usage"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1140" y="755" /><mxPoint x="1055" y="755" /><mxPoint x="1055" y="870" /></Array></mxGeometry></mxCell><mxCell id="secret" value="Read key on first use" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="lambda" target="ssm"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="log" value="Execution logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="lambda" target="logs"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1350" y="635" /><mxPoint x="1350" y="1080" /></Array></mxGeometry></mxCell><mxCell id="planned" value="Future provider switch after access approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#98A3B5;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.2;" edge="1" parent="1" source="lambda" target="bedrock"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1405" y="635" /><mxPoint x="1405" y="840" /></Array></mxGeometry></mxCell><mxCell id="return" value="Response path: Gemini → Lambda → API Gateway → browser.&lt;br&gt;&lt;br&gt;Answers render as safe Markdown; document answers include passage citations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="790" width="315" height="150" /></mxCell><mxCell id="nostore" value="Not deployed: document S3 storage, vector database, VPC/NAT, custom domain or user-managed ACM certificate. CloudFront uses its supplied HTTPS domain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=14;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="1030" width="325" height="115" /></mxCell><mxCell id="foot" value="As-built from deployed project source and confirmed deployment • 21 October 2026 • Solid = active; dashed = optional / planned or management relationship" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1200" width="1700" height="42" /></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="02 · Document and account flows"><mxGraphModel dx="1820" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;THINKING AI  /  02  /  Document and account flows&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#29344A;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1700" height="50" /></mxCell><mxCell id="subtitle" value="Uploading prepares the document. Only an explicit Send action triggers an AI request." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="82" width="1700" height="48" /></mxCell><mxCell id="doczone" value="DOCUMENT QUESTION FLOW · current behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#52637A;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="160" width="1725" height="470" /></mxCell><mxCell id="upload" value="&lt;b&gt;1 · Attach a file&lt;/b&gt;&lt;br&gt;&lt;br&gt;PDF / DOCX / TXT / MD / CSV / JSON / HTML&lt;br&gt;Maximum 10 MB file size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="240" width="260" height="150" /></mxCell><mxCell id="extract" value="&lt;b&gt;2 · Read in browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;PDF.js, Mammoth, or text reader&lt;br&gt;Validate readable content&lt;br&gt;Maximum 200,000 characters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3ED;strokeColor=#52977D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="415" y="240" width="265" height="150" /></mxCell><mxCell id="wait" value="&lt;b&gt;3 · Ready; wait&lt;/b&gt;&lt;br&gt;&lt;br&gt;Show attachment chip&lt;br&gt;No automatic summary&lt;br&gt;No AI call or usage reservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#8065AF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="755" y="240" width="265" height="150" /></mxCell><mxCell id="send" value="&lt;b&gt;4 · User presses Send&lt;/b&gt;&lt;br&gt;&lt;br&gt;Question: max 2,000 characters&lt;br&gt;Send question + document text&lt;br&gt;POST /free or POST /chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#D49136;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1095" y="240" width="265" height="150" /></mxCell><mxCell id="answer" value="&lt;b&gt;5 · Answer with sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;Model answer + passage labels&lt;br&gt;Safe Markdown display&lt;br&gt;Document stays attached" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1435" y="240" width="285" height="150" /></mxCell><mxCell id="upload-extract" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="upload" target="extract"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="extract-wait" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="extract" target="wait"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="wait-send" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wait" target="send"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="send-answer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="send" target="answer"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="followup" value="Follow-up question: send the same attached document again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#8065AF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="answer" target="send"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1575" y="450" /><mxPoint x="1225" y="450" /></Array></mxGeometry></mxCell><mxCell id="lifecycle" value="&lt;b&gt;Document lifecycle&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep in tab memory while conversation is open. Close Conversation / New Conversation / home clears its attachment context. Explicit removal, refresh, or sign-out also clears it. Projects / Recents navigation can restore the attachment before the conversation is closed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#98A3B5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="495" width="1640" height="100" /></mxCell><mxCell id="retrievalzone" value="LAMBDA RETRIEVAL · bounded text retrieval, not embeddings or a vector database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#52637A;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="665" width="1725" height="250" /></mxCell><mxCell id="retrieve" value="&lt;b&gt;Question-aware passage selection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Split extracted text into paragraph-aware chunks.&lt;br&gt;Rank by query word overlap; choose up to 6 matching passages.&lt;br&gt;If none match, use a small bounded excerpt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#D49136;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="735" width="520" height="135" /></mxCell><mxCell id="context" value="&lt;b&gt;Bounded model prompt&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maximum document context: 12,000 characters.&lt;br&gt;Document treated as untrusted source material.&lt;br&gt;General questions use separate general-assistant instructions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#8065AF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="665" y="735" width="490" height="135" /></mxCell><mxCell id="citations" value="&lt;b&gt;Grounded response&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maximum output: 1,024 tokens per answer.&lt;br&gt;Return answer, provider and retrieved passage citations.&lt;br&gt;User may explicitly request a summary in their instruction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="735" width="500" height="135" /></mxCell><mxCell id="retctx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="retrieve" target="context"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ctxcit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="context" target="citations"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="authzone" value="PRO ACCOUNT FLOW · Free requests do not require this flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#52637A;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="950" width="1725" height="330" /></mxCell><mxCell id="signup" value="&lt;b&gt;Create account&lt;/b&gt;&lt;br&gt;&lt;br&gt;Name + email + password&lt;br&gt;Cognito SignUp&lt;br&gt;12-character password policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE9EE;strokeColor=#B8758D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1025" width="265" height="150" /></mxCell><mxCell id="confirm" value="&lt;b&gt;Verify email&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cognito sends email code&lt;br&gt;ConfirmSignUp with code&lt;br&gt;Resend code supported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE9EE;strokeColor=#B8758D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="1025" width="265" height="150" /></mxCell><mxCell id="signin" value="&lt;b&gt;Go to sign-in&lt;/b&gt;&lt;br&gt;&lt;br&gt;Email + password&lt;br&gt;USER_PASSWORD_AUTH&lt;br&gt;Existing invited accounts supported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE9EE;strokeColor=#B8758D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="760" y="1025" width="265" height="150" /></mxCell><mxCell id="session" value="&lt;b&gt;Authenticated session&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cognito ID token in tab memory&lt;br&gt;Sidebar displays saved name&lt;br&gt;No automatic login after signup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="1025" width="265" height="150" /></mxCell><mxCell id="proapi" value="&lt;b&gt;Pro questions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authorization: Bearer JWT&lt;br&gt;API Gateway validates issuer / client&lt;br&gt;POST /chat → Lambda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#8065AF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="1025" width="280" height="150" /></mxCell><mxCell id="signup-confirm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="signup" target="confirm"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="confirm-signin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="confirm" target="signin"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="signin-session" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="signin" target="session"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="session-proapi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="session" target="proapi"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="authnote" value="Account and chat data are not persisted by the browser app across refresh. Cognito retains registered account attributes. Passwords are sent directly to Cognito and cleared from the form." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=14;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1210" width="1620" height="35" /></mxCell><mxCell id="foot" value="As-built from deployed project source and confirmed deployment • 21 October 2026 • Solid = active; dashed = optional / planned or management relationship" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1330" width="1700" height="42" /></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="03 · Deployment and controls"><mxGraphModel dx="1820" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1310" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;THINKING AI  /  03  /  Deployment and controls&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=#29344A;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1700" height="50" /></mxCell><mxCell id="subtitle" value="Manual PowerShell + SAM deployment. The AWS-hosted frontend is public; the S3 origin remains private." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="82" width="1700" height="48" /></mxCell><mxCell id="deployzone" value="DEPLOYMENT PATH · existing stack: thinking-ai-backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;spacing=16;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#52637A;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="160" width="1725" height="420" /></mxCell><mxCell id="developer" value="&lt;b&gt;Developer workstation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows PowerShell&lt;br&gt;AWS CLI + AWS SAM CLI&lt;br&gt;Existing samconfig.toml&lt;br&gt;Manual deployment from existing setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="235" width="280" height="165" /></mxCell><mxCell id="sam" value="&lt;b&gt;Backend deployment&lt;/b&gt;&lt;br&gt;&lt;br&gt;sam validate --lint&lt;br&gt;sam build&lt;br&gt;sam deploy → CloudFormation&lt;br&gt;SAM-managed S3 code artifact bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#D49136;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="455" y="235" width="300" height="165" /></mxCell><mxCell id="stack" value="&lt;b&gt;CloudFormation-managed resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;API Gateway + Lambda + IAM role&lt;br&gt;DynamoDB usage table&lt;br&gt;Cognito user pool + public app client&lt;br&gt;CloudWatch log group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBFA;strokeColor=#8065AF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="235" width="360" height="165" /></mxCell><mxCell id="frontend" value="&lt;b&gt;Frontend deployment&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload index.html, aws-client.js, markdown.js&lt;br&gt;aws s3 sync → private website bucket&lt;br&gt;CloudFront invalidation → fresh edge assets&lt;br&gt;CloudFront and website bucket managed separately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3ED;strokeColor=#52977D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1305" y="235" width="410" height="165" /></mxCell><mxCell id="depsam" value="Local build + source package" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="developer" target="sam"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="samstack" value="Review and approve changeset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sam" target="stack"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="depweb" value="Frontend files + cache invalidation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#6E7F99;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="developer" target="frontend"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="220" y="470" /><mxPoint x="1510" y="470" /></Array></mxGeometry></mxCell><mxCell id="ci" value="No GitHub Actions / automatic CI deployment is configured. A separate ChatGPT Sites publication remains available and shares the same AWS API." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="510" width="1640" height="40" /></mxCell><mxCell id="quotas" value="&lt;b&gt;Daily application allowances&lt;/b&gt;&lt;br&gt;&lt;br&gt;Free: 50 requests per network / UTC day&lt;br&gt;All Free visitors share 100 requests / day&lt;br&gt;Pro: 40 requests per account / UTC day&lt;br&gt;Overall site: 100 requests / day across both plans&lt;br&gt;&lt;br&gt;Each submitted AI request reserves usage atomically.&lt;br&gt;Failed provider requests can still consume allowance.&lt;br&gt;Counters reset by UTC date; records expire via TTL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FC;strokeColor=#5B89C4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="635" width="540" height="255" /></mxCell><mxCell id="security" value="&lt;b&gt;Access and data boundaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;S3: public access blocked; CloudFront OAC only&lt;br&gt;API CORS: CloudFront + original ChatGPT Sites origin&lt;br&gt;Pro: Cognito JWT checked before Lambda invocation&lt;br&gt;IAM: least-privilege access to usage table and SSM key&lt;br&gt;Gemini key never embedded in frontend files&lt;br&gt;Document text transmitted to AWS and Gemini on Send&lt;br&gt;No persistent document storage or vector index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3ED;strokeColor=#52977D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="635" width="565" height="255" /></mxCell><mxCell id="cost" value="&lt;b&gt;Operational controls&lt;/b&gt;&lt;br&gt;&lt;br&gt;1,024 output tokens maximum per answer&lt;br&gt;Lambda: ARM64 / 256 MB / 28 seconds&lt;br&gt;HTTP API: throttle 1 request/s, burst 2&lt;br&gt;DynamoDB: on-demand + TTL&lt;br&gt;CloudWatch log retention: 3 days&lt;br&gt;APP_ENABLED can pause AI requests&lt;br&gt;No automatic model upgrade or provider retries&lt;br&gt;Provider quotas apply independently of app allowances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#D49136;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="635" width="540" height="255" /></mxCell><mxCell id="endpoints" value="&lt;b&gt;Current endpoints and resource identifiers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Website: https://d3nv2zhw5ihk84.cloudfront.net&lt;br&gt;API: https://k88j7c124j.execute-api.us-east-1.amazonaws.com&lt;br&gt;Cognito user pool: us-east-1_VXXacSNo9&lt;br&gt;Cognito public client: 6phjsdjk5cdlrtuhnd9pm7pddb&lt;br&gt;Lambda: thinking-ai-backend-ChatFunction-8hQVb0pfDJvG&lt;br&gt;CloudFront: E1Q60LVMJ9T8M9&lt;br&gt;Website bucket: thinking-ai-web-912010732788" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#98A3B5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="940" width="1145" height="250" /></mxCell><mxCell id="future" value="&lt;b&gt;Future options · not active&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bedrock: awaiting access / quota review; Gemini remains primary.&lt;br&gt;Custom domain: not configured; CloudFront default TLS in use.&lt;br&gt;Persistent projects and chat history: not implemented.&lt;br&gt;Long-term document storage / embeddings / vector retrieval: not implemented.&lt;br&gt;Billing alerts or additional monitoring alarms: not verified as deployed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#98A3B5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;fontColor=#26354B;align=left;verticalAlign=top;spacing=18;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1225" y="940" width="540" height="250" /></mxCell><mxCell id="foot" value="As-built from deployed project source and confirmed deployment • 21 October 2026 • Solid = active; dashed = optional / planned or management relationship" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1240" width="1700" height="42" /></mxCell></root></mxGraphModel></diagram></mxfile>