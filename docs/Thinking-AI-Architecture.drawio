        <mxCell id="c5" value="&lt;b&gt;First message&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Conversation appears in Recents&lt;br&gt;while it is still active&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#eff6ff;strokeColor=#93b7ec;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="73" y="186" width="268" height="103" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;New Conversation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Keeps prior conversation in Recents&lt;br&gt;Starts an empty chat&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#eff6ff;strokeColor=#93b7ec;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="406" y="186" width="277" height="103" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Select a recent chat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Reopen its in-memory messages&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#eff6ff;strokeColor=#93b7ec;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="755" y="186" width="272" height="103" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Refresh or sign out&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Clears Recents and chat history&lt;br&gt;Requires sign-in again&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#f5f7fa;strokeColor=#b0bdcb;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
