        <mxCell id="c27" value="After publish, the admin Lambda can queue fallback indexing and request Bedrock ingestion. Fallback indexing does not depend on Bedrock." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#182e44;fontSize=14;fontStyle=0;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="74" y="648" width="688" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="Bedrock sync can be unavailable when embedding quota is zero. A ready text index can still support fallback chat." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#182e44;fontSize=14;fontStyle=0;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="867" y="648" width="593" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="Deletion marks the catalog entry deleted before cleanup. Stale indexes do not authorize retrieval. Source and cache cleanup can be retried." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#4d6378;fontSize=14;fontStyle=0;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="50" y="801" width="1450" height="43" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
