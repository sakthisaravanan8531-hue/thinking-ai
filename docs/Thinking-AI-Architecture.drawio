        <mxCell id="c14" value="RELEASE ORDER  /  MANUAL AWS DEPLOYMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#435d73;fontSize=14;fontStyle=1;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="64" y="413" width="1434" height="26" as="geometry" />
