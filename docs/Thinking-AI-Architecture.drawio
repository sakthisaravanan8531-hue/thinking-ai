        <mxCell id="c15" value="&lt;b&gt;A   Local text search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Current question only&lt;br&gt;Check department, catalog and ETag&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=59;spacingRight=8;fillColor=#ecf8f2;strokeColor=#87bea6;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
