        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;2   Backend stack&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;SAM: validate, build and deploy&lt;br&gt;Review the stack changeset&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#fff5e9;strokeColor=#e5ad68;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
