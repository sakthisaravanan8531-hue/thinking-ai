        <mxCell id="c17" value="&lt;b&gt;B   Match and rank passages&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Exact terms first; bounded typo match&lt;br&gt;No evidence → decline without Gemini&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#eff6ff;strokeColor=#93b7ec;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="437" y="509" width="275" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;C   Ask Gemini once&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Use authorized passages only&lt;br&gt;Explain topic with source excerpts&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=59;spacingRight=8;fillColor=#f5efff;strokeColor=#bca8e6;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="779" y="509" width="310" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2280%22%20height%3D%2280%22%20viewBox%3D%220%200%2080%2080%22%3E%3Crect%20width%3D%2280%22%20height%3D%2280%22%20rx%3D%228%22%20fill%3D%22%23E4EEFF%22%2F%3E%3Cpath%20d%3D%22M40%208c3%2020%2012%2029%2032%2032-20%203-29%2012-32%2032C37%2052%2028%2043%208%2040c20-3%2029-12%2032-32Z%22%20fill%3D%22%234D76BC%22%2F%3E%3C%2Fsvg%3E;" parent="1" vertex="1">
          <mxGeometry x="791" y="549" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;D   Verify and return&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;Validate exact excerpts and citations&lt;br&gt;Recheck access; return or decline&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#ecf8f2;strokeColor=#87bea6;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="1155" y="509" width="321" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Unavailable, cooldown, or no approved passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718a;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#8256b0;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="c6" target="c15">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="482" y="385" />
              <mxPoint x="223" y="385" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c22" value="Unavailable after retrieval: reuse approved passages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718a;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#8256b0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="c8" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718a;fontSize=12;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c15" target="c17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718a;fontSize=12;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c17" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#58718a;fontSize=12;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c18" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="Bedrock availability errors can open a five-minute shared cooldown. Safety refusals, grounding interventions and unsupported primary output do not trigger fallback." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#4d6378;fontSize=14;fontStyle=0;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="50" y="719" width="1450" height="43" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="Gemini fallback verifies source excerpts and citations. Its labeled background explanations are not independently checked by a Bedrock Guardrail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#4d6378;fontSize=14;fontStyle=0;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="50" y="766" width="1450" height="43" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="Examples: iaac → IaC; terrafom → Terraform; postgressql → PostgreSQL. Short or ambiguous terms are handled conservatively." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#4d6378;fontSize=14;fontStyle=0;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="50" y="813" width="1450" height="43" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
