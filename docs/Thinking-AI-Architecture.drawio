        <mxCell id="c15" value="&lt;b&gt;1   Knowledge support stack&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#40566b&quot;&gt;CloudFormation: catalog + guardrail&lt;br&gt;Reuse existing KB, source and index&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#fff5e9;strokeColor=#e5ad68;fontColor=#14263a;fontSize=16;" parent="1" vertex="1">
